# Copy the required keys into the deployment environment after confirming the real hostnames.
# Do not commit real values or secrets.

# Comma-separated browser origins allowed to call the API with cookies.
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND-DOMAIN

# Include frontend hostnames and ports that initiate Sanctum stateful requests.
SANCTUM_STATEFUL_DOMAINS=YOUR-FRONTEND-DOMAIN

# For same-site subdomains, use the shared parent domain (for example .example.com).
# For separate registrable domains, leave unset and configure SameSite=None with HTTPS.
SESSION_DOMAIN=YOUR_COOKIE_DOMAIN
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Required independently for Paystack production billing. Never put values in source control.
PAYSTACK_SECRET_KEY=SET_IN_SECRET_MANAGER
# Configure each paid subscription_plans.paystack_plan_code with the actual Paystack plan code.
